---
import SocialLinks from './SocialLinks.astro';
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container">
    <!--<p class="hero-eyebrow">av4008 · new york university</p> -->

    <h1 id="hero-heading">Aravindan Vemula</h1>

    <p class="hero-subtitle">Computer Science Graduate Student · Software &amp; ML&nbsp;Systems</p>

    <p class="hero-intro">
      I'm a Computer Science graduate student at NYU interested in building
      scalable software systems, machine learning infrastructure, and
      data-intensive applications. I enjoy working across the stack, from
      distributed data pipelines to intelligent applications.
    </p>

    <div class="hero-actions">
      <a class="button" href="#projects">View Projects</a>
      <SocialLinks />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(4rem, 12vw, 8rem) clamp(3.5rem, 9vw, 6.5rem);
  }

  .hero-eyebrow {
    margin: 0 0 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    text-transform: lowercase;
    color: var(--text-faint);
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 7vw, 4.25rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .hero-subtitle {
    margin: 1rem 0 0;
    font-size: clamp(1.0625rem, 2.4vw, 1.375rem);
    color: var(--accent);
    font-weight: 500;
  }

  .hero-intro {
    margin: 1.5rem 0 0;
    max-width: 62ch;
    font-size: clamp(1rem, 1.6vw, 1.0625rem);
    color: var(--text-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.25rem;
    margin-top: 2.25rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.6875rem 1.25rem;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 0.9375rem;
    font-weight: 600;
    transition: background-color 160ms ease, transform 160ms ease;
  }

  .button:hover {
    background: var(--accent-strong);
    transform: translateY(-1px);
  }

  .button:active {
    transform: translateY(0);
  }
</style>
