---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Aravindan Vemula — Software & ML Systems',
  description = 'Portfolio of Aravindan Vemula, a Computer Science graduate student at New York University working on machine learning infrastructure, distributed systems, and data-intensive applications.',
} = Astro.props;

// Canonical/OG URL is only emitted when `site` is configured (set during the
// GitHub Pages build). Local dev builds skip it rather than emit a broken link.
const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const personSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Aravindan Vemula',
  email: 'mailto:av4008@nyu.edu',
  url: pageUrl?.href,
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'New York University' },
  jobTitle: 'Computer Science Graduate Student',
  sameAs: ['https://github.com/aravindan2', 'https://linkedin.com/in/aravindan-v12'],
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {pageUrl && <link rel="canonical" href={pageUrl.href} />}
    <meta name="author" content="Aravindan Vemula" />
    <meta name="theme-color" content="#0b0c0f" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="any" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Aravindan Vemula" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {pageUrl && <meta property="og:url" content={pageUrl.href} />}
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={personSchema} is:inline />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Navbar />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
